---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import {
  ATTRACTION_FULL_NAME, ATTRACTION_SHORT_NAME, ATTRACTION_LOCAL_NAME,
  CITY_NAME, STATE_PROVINCE, COUNTRY_NAME, COUNTRY_CODE_2LETTER, POSTAL_CODE,
  STREET_ADDRESS, PLUS_CODE, LATITUDE, LONGITUDE, CATEGORY,
  MAPS_SHARE_URL, MAPS_EMBED_SRC, RATING_VALUE, RATING_COUNT, RATING_SYNC,
  NEARBY_LANDMARK_1, NEARBY_LANDMARK_2, GOVT_TOURISM_URL, GOVT_TOURISM_LABEL,
  HERO_IMAGE, OG_IMAGE, SITE_ORIGIN, absoluteUrl
} from '../data/site';

const site = Astro.site;
const pageUrl = site ? new URL('/', site).toString() : SITE_ORIGIN;
const attractionId = `${pageUrl}#attraction`;
const mainPhoto = 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Dona_Paula%2C_Goa.jpg';

const pageTitle = `${ATTRACTION_FULL_NAME} Goa – Entry Fee, Timings, History & Location`;
const pageDescription = `Planning a visit to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}? Find entry fee, opening hours (timings), distance from Panjim, directions, history and the best sunset viewpoints.`;
const ogTitle = `${ATTRACTION_FULL_NAME} Goa – Visitor Guide`;
const ogDescription = `Entry fee, opening hours, distance from Panjim, directions and how to reach ${ATTRACTION_FULL_NAME} in ${STATE_PROVINCE}.`;
const heroAlt = `${ATTRACTION_FULL_NAME} - Main view in ${CITY_NAME}, ${COUNTRY_NAME}`;

const entityFacts: Array<[string, string]> = [
  ['Official name', ATTRACTION_FULL_NAME],
  ['Also known as', `${ATTRACTION_SHORT_NAME} · ${ATTRACTION_LOCAL_NAME}`],
  ['City', CITY_NAME],
  ['State / UT', STATE_PROVINCE],
  ['Country', COUNTRY_NAME],
  ['Postal code', POSTAL_CODE],
  ['Plus Code', PLUS_CODE],
  ['Coordinates', `${LATITUDE}, ${LONGITUDE}`],
  ['Category', CATEGORY]
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': attractionId,
  name: ATTRACTION_FULL_NAME,
  alternateName: [
    ATTRACTION_SHORT_NAME,
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`,
    ATTRACTION_LOCAL_NAME
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: pageUrl,
  image: [absoluteUrl(HERO_IMAGE), mainPhoto, absoluteUrl(OG_IMAGE)],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: STREET_ADDRESS,
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER
  },
  geo: { '@type': 'GeoCoordinates', latitude: LATITUDE, longitude: LONGITUDE },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, GOVT_TOURISM_URL],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: RATING_VALUE, reviewCount: RATING_COUNT, bestRating: 5, worstRating: 1 },
  openingHoursSpecification: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'].map(day => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${day}`, opens: '08:00', closes: '22:00' })),
  priceRange: '₹'
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: pageUrl },
    { '@type': 'ListItem', position: 2, name: COUNTRY_NAME },
    { '@type': 'ListItem', position: 3, name: STATE_PROVINCE },
    { '@type': 'ListItem', position: 4, name: CITY_NAME },
    { '@type': 'ListItem', position: 5, name: ATTRACTION_FULL_NAME, item: attractionId }
  ]
};

const faq: Array<[string, string]> = [
  ['Where is ' + ATTRACTION_FULL_NAME + ' located?', `${ATTRACTION_FULL_NAME} is located at ${STREET_ADDRESS}, ${CITY_NAME}, ${STATE_PROVINCE} ${POSTAL_CODE}, ${COUNTRY_NAME} (Plus Code ${PLUS_CODE}), on the headland south-west of central ${CITY_NAME}.`],
  ['Is ' + ATTRACTION_SHORT_NAME + ' free to visit?', `The public seafront and viewpoint promenade at ${ATTRACTION_FULL_NAME} are open without a general admission charge. A ₹50 tourist entry fee is commonly listed for the jetty area, and charges or exemptions can change — verify at the entrance or through Goa Tourism before travelling.`],
  ['Is Dona Paula View Point the same as Dona Paula Jetty?', 'For most visitors, yes. Map listings and travel references commonly use the names for the same waterfront sightseeing area around the renovated jetty and viewpoint.'],
  ['What is the usual entry fee?', 'A ₹50 tourist entry fee is commonly listed for the jetty area. Charges and exemptions can change, so verify at the entrance or through Goa Tourism before travelling.'],
  ['How long should I allow?', 'About 45–60 minutes works for the viewpoint, photographs and a relaxed walk. Allow longer around sunset or if combining the stop with nearby Panaji sights.'],
  ['What time is best?', 'Late afternoon offers softer light and sunset potential. Early morning is usually cooler and quieter. Weekends and holidays can be busy.'],
  ['Is the viewpoint step-free?', 'The renovated promenade is paved, but some elevated viewing sections involve steps and gradients. Visitors with reduced mobility should allow extra time and check current access conditions on arrival.'],
  ['Can I park next to the jetty?', 'Parking is managed away from the tightest jetty approach. Government project material identifies parking near NIO Circle, including spaces for two-wheelers, cars and buses. Road restrictions can change during events.'],
  ['Are toilets and food available?', 'Public visitor infrastructure has been improved in the wider Dona Paula tourism zone. Treat toilet opening, drinking-water access and vendor availability as variable, especially early or late in the day.'],
  ['Is swimming the main activity here?', 'No. This is primarily a viewpoint, promenade and jetty stop. Sea conditions, rocks and boat activity mean visitors should not assume the viewpoint area is suitable for swimming.'],
  ['How far is Dona Paula View Point from Panaji (Panjim)?', `${CITY_NAME} (Panjim) is roughly 7 km from ${ATTRACTION_FULL_NAME}; by road it is typically a 20–30 minute trip from Panaji Bus Stand or the city centre, longer in evening congestion. Kadamba city buses run to Dona Paula Circle.`],
  ['What are the opening hours / timings?', 'As a public headland, the seafront and promenade are normally visited in daylight. Goa Tourism material commonly lists the jetty/tourist area hours of 08:00–22:00, but access and fees can change — confirm locally before travel.']
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<BaseLayout title={pageTitle} description={pageDescription} path="/" image={OG_IMAGE} imageAlt={heroAlt} ogTitle={ogTitle} ogDescription={ogDescription}>
<script type="application/ld+json" is:inline set:html={JSON.stringify(attractionSchema)}></script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>
<section class="hero-grid min-h-[82vh] text-white"><div class="wrap flex min-h-[82vh] items-end py-16"><div class="max-w-3xl"><p class="eyebrow !text-[#ffd5ac]">Panaji · Goa · Arabian Sea</p><h1 class="serif mt-4 text-5xl font-bold leading-[.98] md:text-7xl">{ATTRACTION_FULL_NAME} ({CITY_NAME})</h1><p class="serif mt-4 text-2xl italic text-white/85">Where Goa’s capital meets the sea.</p><p class="mt-6 max-w-2xl text-lg leading-8 text-white/85">A field guide to Dona Paula View Point — its renovated jetty, layered history, coastal geography, practical access and the stories that have gathered around this headland.</p><div class="mt-8 flex flex-wrap gap-3"><a href="#visit" class="rounded-full bg-[#f0aa64] px-6 py-3 font-bold text-[#072e33]">Plan your visit</a><a href="#story" class="rounded-full border border-white/40 bg-white/10 px-6 py-3 font-bold">Read the story</a></div><div class="mt-9 grid max-w-2xl grid-cols-3 gap-3 text-sm"><div class="rounded-2xl bg-black/25 p-4 backdrop-blur"><b class="block text-xl">4.1 / 5</b><span class="text-white/70">Google Maps rating*</span></div><div class="rounded-2xl bg-black/25 p-4 backdrop-blur"><b class="block text-xl">08:00–22:00</b><span class="text-white/70">commonly listed hours*</span></div><div class="rounded-2xl bg-black/25 p-4 backdrop-blur"><b class="block text-xl">₹50</b><span class="text-white/70">commonly listed tourist fee*</span></div></div><p class="mt-3 text-xs text-white/65">*Visitor-facing details can change; verify locally before travel.</p></div></div></section>
<section id="about" class="section"><div class="wrap grid gap-10 md:grid-cols-[1.05fr_.95fr]"><div><p class="eyebrow">About {ATTRACTION_FULL_NAME}</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33] md:text-5xl">The viewpoint that gives {CITY_NAME} its sea front.</h2><p class="mt-6 leading-8 text-[#4c6464]">Welcome to <b>{ATTRACTION_FULL_NAME}</b>, widely recognised by the same short name as <b>{ATTRACTION_SHORT_NAME}</b> — the waterfront promenade and pier most visitors mean when they say “Dona Paula”. Located in <b>{CITY_NAME}</b>, <b>{STATE_PROVINCE}</b>, <b>{COUNTRY_NAME}</b>, this destination serves as a primary coastal hub for travellers visiting the region.</p><p class="mt-4 leading-8 text-[#4c6464]">The headland looks out over the Arabian Sea at the entrance to Goa’s harbour, which is why railway, road and sea routes have all converged on this corner of {CITY_NAME} for more than a century.</p><p class="mt-6 text-sm font-bold uppercase tracking-[.14em] text-[#8a9795]">Geographic hierarchy</p><p class="mt-3 flex flex-wrap items-center gap-2 text-sm font-semibold text-[#0f6870]"><span>{ATTRACTION_FULL_NAME}</span><span aria-hidden="true">→</span><span>{CITY_NAME}</span><span aria-hidden="true">→</span><span>{STATE_PROVINCE}</span><span aria-hidden="true">→</span><span>{COUNTRY_NAME}</span></p></div><div><figure class="overflow-hidden rounded-[32px] border border-[#cbdad7] bg-white shadow-xl"><img src={mainPhoto} alt={heroAlt} width="1200" height="800" loading="eager" decoding="async" class="h-[300px] w-full object-cover" /><figcaption class="px-5 py-4 text-sm leading-6 text-[#5b6d6d]">{ATTRACTION_FULL_NAME} — main sea view, {CITY_NAME}. Photograph via Wikimedia Commons; creator and licence details on the source page.</figcaption></figure><dl class="mt-6 grid gap-3 sm:grid-cols-2">{entityFacts.map(([k, v]) => <div class="card p-4"><dt class="text-xs font-bold uppercase tracking-[.12em] text-[#8a9795]">{k}</dt><dd class="mt-1 text-sm font-semibold leading-6 text-[#072e33]">{v}</dd></div>)}</dl></div></div></section>
<section class="section"><div class="wrap grid gap-10 md:grid-cols-[.9fr_1.1fr]"><div class="photo-commons-2 min-h-[430px] rounded-[32px] bg-[#dce9e6]"></div><div id="story"><p class="eyebrow">History, not mythology</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33] md:text-5xl">History &amp; Significance of {ATTRACTION_FULL_NAME}</h2><p class="mt-6 leading-8 text-[#4c6464]">Dona Paula sits on the headland south-west of central Panaji. The wider Cabo peninsula has long held strategic importance at the entrance to Goa’s harbour. Government records place a Portuguese fort at Cabo in 1540; the site later evolved into the Governor’s residence, today known as Lok Bhavan.</p><p class="mt-4 leading-8 text-[#4c6464]">The name “Dona Paula” is associated with Paula Menezes, whose burial is recorded at the chapel on the Cabo estate. Local tradition has produced several dramatic stories about her life — including a forbidden romance and a fatal end — but Lok Bhavan’s own historical note explicitly treats these as conjecture rather than established fact.</p><div class="mt-7 rounded-3xl border-l-4 border-[#e78555] bg-[#fff6e9] p-6"><b class="text-[#072e33]">How this guide handles the legend</b><p class="mt-2 leading-7 text-[#5a6765]">We present the stories as folklore because they are part of the site’s cultural memory, while keeping the documented record separate. That distinction is important for a professional visitor-information site.</p></div></div></div></section>
<section class="bg-[#072e33] py-20 text-white"><div class="wrap grid gap-8 md:grid-cols-3"><div><p class="eyebrow !text-[#f0aa64]">The landscape</p><h2 class="serif mt-3 text-4xl font-bold">A viewpoint shaped by water.</h2></div><div class="md:col-span-2 grid gap-5 sm:grid-cols-2"><div class="rounded-3xl bg-white/8 p-6"><b class="text-lg">Arabian Sea horizon</b><p class="mt-2 leading-7 text-white/70">The open-water view is the defining experience, with coastal light changing quickly through haze, monsoon clouds and sunset.</p></div><div class="rounded-3xl bg-white/8 p-6"><b class="text-lg">Mandovi–Zuari setting</b><p class="mt-2 leading-7 text-white/70">The Dona Paula headland sits between the river systems and sea approaches that have shaped Panaji’s harbour geography.</p></div><div class="rounded-3xl bg-white/8 p-6"><b class="text-lg">Renovated promenade</b><p class="mt-2 leading-7 text-white/70">A 2023 government tourism project upgraded paving, lighting, railings, kiosk areas and parking support around the jetty zone.</p></div><div class="rounded-3xl bg-white/8 p-6"><b class="text-lg">Sunset crowds</b><p class="mt-2 leading-7 text-white/70">The same west-facing light that makes evening attractive also concentrates visitors. Arrive earlier if you value quieter viewing.</p></div></div></div></section>
<section id="visit" class="section"><div class="wrap"><p class="eyebrow">Plan your visit</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33]">Location &amp; How to Visit {ATTRACTION_SHORT_NAME} in {CITY_NAME}</h2><p class="mt-5 max-w-3xl leading-8 text-[#536969]">{ATTRACTION_FULL_NAME} sits at {STREET_ADDRESS}, {CITY_NAME}, {STATE_PROVINCE} {POSTAL_CODE}, {COUNTRY_NAME} — Plus Code {PLUS_CODE}. From central {CITY_NAME} (also called Panjim) it is about 7 km away, a 20–30 minute road trip depending on traffic. The public seafront is open without a general admission charge; a ₹50 tourist fee is commonly listed for the jetty area, and the tourist zone is usually visited in daylight (commonly listed hours 08:00–22:00).</p><div class="mt-10 grid gap-5 md:grid-cols-3"><div class="card p-6"><span class="text-2xl">◷</span><h3 class="mt-4 font-bold text-[#072e33]">Best time &amp; stay</h3><p class="mt-2 leading-7 text-[#536969]">Early morning for lower heat and fewer people; late afternoon for golden light. A practical visit is 45–60 minutes, or 60–90 minutes around sunset.</p></div><div class="card p-6"><span class="text-2xl">₹</span><h3 class="mt-4 font-bold text-[#072e33]">Tickets / fees</h3><p class="mt-2 leading-7 text-[#536969]">Goa Tourism material lists a ₹50 Dona Paula Jetty charge. Fee policies can change, including possible resident exemptions, so treat this as a planning figure rather than a guaranteed tariff.</p></div><div class="card p-6"><span class="text-2xl">P</span><h3 class="mt-4 font-bold text-[#072e33]">Parking</h3><p class="mt-2 leading-7 text-[#536969]">Government project records identify parking near NIO Circle for 38 two-wheelers, 55 cars and 4 buses. The narrow approach may be traffic-controlled; do not rely on curbside parking.</p></div></div></div></section>
<WeatherSection />
<section class="bg-[#edf5f2] py-20"><div class="wrap"><p class="eyebrow">Facilities checklist</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33]">Visitor services &amp; facilities (type-neutral overview)</h2><p class="mt-4 max-w-3xl leading-8 text-[#536969]">Everything below is described by <b>type, not by brand</b>. This guide does not rank, advertise or endorse individual businesses — use your own judgement on price, hygiene and current opening hours.</p><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{[['WC / toilets','Use designated public or visitor facilities; availability can vary by opening hours.'],['Food & drinks','Expect snack stalls, cafés and casual dining types in the wider neighbourhood; this guide does not endorse specific vendors.'],['Accommodation','Guest houses, serviced apartments, mid-range hotels and full-service resorts are available across Dona Paula and Panaji.'],['Groceries','Neighbourhood convenience stores, pharmacies and supermarkets are available on the Panaji–Dona Paula corridor.'],['Fuel','Petrol stations are available on main urban roads; refuel before entering congested tourist approaches.'],['EV charging','Public and hotel-based charging exists in the Panaji urban area, but availability and connector access should be checked in your charging app.'],['Mobile signal','Urban mobile coverage is generally available; sea-facing edges can still have variable signal.'],['Shade & weather','Shade is limited on exposed viewing areas. Carry water and sun protection; during monsoon, watch for wind and slippery surfaces.']].map(([h,p])=><div class="card p-5"><h3 class="font-bold text-[#072e33]">{h}</h3><p class="mt-2 text-sm leading-6 text-[#5b6d6d]">{p}</p></div>)}</div></div></section>
<section id="transport" class="section"><div class="wrap grid gap-10 lg:grid-cols-[1fr_1.05fr]"><div><p class="eyebrow">Detailed transport</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33]">Getting to Dona Paula</h2><div class="mt-7 space-y-5"><div><h3 class="font-bold text-[#072e33]">From Goa International Airport (Dabolim)</h3><p class="mt-2 leading-7 text-[#536969]">Road travel is the practical option. Prepaid airport taxi, app-based taxi where available, or a private transfer can take you toward Panaji and then Dona Paula. Build in extra time for Panaji traffic and evening congestion.</p></div><div><h3 class="font-bold text-[#072e33]">From Manohar International Airport (Mopa)</h3><p class="mt-2 leading-7 text-[#536969]">The airport is farther north. Taxi or airport-bus connections toward Panaji are the simplest public-facing options; from Panaji, continue by city bus, taxi or auto-rickshaw toward Dona Paula.</p></div><div><h3 class="font-bold text-[#072e33]">By city bus</h3><p class="mt-2 leading-7 text-[#536969]">Kadamba Transport’s Panaji electric-bus network includes Dona Paula Circle on a route connecting Panaji Bus Stand, Panaji Market, Kala Academy, Miramar and Caranzalem. Timetables change, so check KTCL before departure.</p></div><div><h3 class="font-bold text-[#072e33]">Taxi / auto-rickshaw</h3><p class="mt-2 leading-7 text-[#536969]">Good for point-to-point travel from Panaji, Miramar or nearby accommodation. During peak sunset hours, arrange pickup away from the most congested jetty approach if traffic officers restrict access.</p></div><div><h3 class="font-bold text-[#072e33]">Walking / cycling</h3><p class="mt-2 leading-7 text-[#536969]">Possible from parts of Caranzalem and Dona Paula, but heat, gradients and traffic make this better suited to confident walkers or cyclists outside the hottest hours.</p></div></div></div><div class="overflow-hidden rounded-[30px] border border-[#cbdad7] bg-white shadow-xl"><iframe title={`Map of ${ATTRACTION_FULL_NAME}, ${CITY_NAME}`} src={MAPS_EMBED_SRC} width="100%" height="620" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div><div class="mt-7 overflow-hidden rounded-2xl border border-[#d8e3df]"><table class="w-full text-left text-sm"><thead class="bg-[#072e33] text-white"><tr><th class="px-4 py-3 font-semibold">Mode</th><th class="px-4 py-3 font-semibold">From</th><th class="px-4 py-3 font-semibold">Typical time</th><th class="px-4 py-3 font-semibold">Notes</th></tr></thead><tbody class="divide-y divide-[#e2ece9]"><tr><td class="px-4 py-3 font-semibold text-[#072e33]">Airport taxi / transfer</td><td class="px-4 py-3 text-[#536969]">Goa (Dabolim) Airport</td><td class="px-4 py-3 text-[#536969]">45–60 min</td><td class="px-4 py-3 text-[#536969]">Prepaid or app-based; allow extra for Panaji traffic.</td></tr><tr><td class="px-4 py-3 font-semibold text-[#072e33]">Airport taxi / transfer</td><td class="px-4 py-3 text-[#536969]">Manohar (Mopa) Airport</td><td class="px-4 py-3 text-[#536969]">70–90 min</td><td class="px-4 py-3 text-[#536969]">Farther north; bus or taxi toward Panaji first.</td></tr><tr><td class="px-4 py-3 font-semibold text-[#072e33]">City bus</td><td class="px-4 py-3 text-[#536969]">Panaji Bus Stand / Market</td><td class="px-4 py-3 text-[#536969]">25–40 min</td><td class="px-4 py-3 text-[#536969]">Kadamba electric bus to Dona Paula Circle; check KTCL timings.</td></tr><tr><td class="px-4 py-3 font-semibold text-[#072e33]">Taxi / auto-rickshaw</td><td class="px-4 py-3 text-[#536969]">Panaji / Miramar</td><td class="px-4 py-3 text-[#536969]">15–30 min</td><td class="px-4 py-3 text-[#536969]">Best for door-to-door; pre-arrange pickup away from jetty.</td></tr><tr><td class="px-4 py-3 font-semibold text-[#072e33]">Walk / cycle</td><td class="px-4 py-3 text-[#536969]">Caranzalem / Dona Paula</td><td class="px-4 py-3 text-[#536969]">20–40 min</td><td class="px-4 py-3 text-[#536969]">Only outside peak heat; gradients and traffic to consider.</td></tr></tbody></table></div><div class="wrap mt-8 grid gap-4 md:grid-cols-2"><a class="card flex items-center justify-between gap-4 p-5" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer"><span><b class="text-[#072e33]">Open {ATTRACTION_FULL_NAME} on Google Maps</b><span class="mt-1 block text-sm text-[#60706e]">{STREET_ADDRESS}, {CITY_NAME} {POSTAL_CODE}</span></span><span aria-hidden="true" class="text-2xl text-[#0f6870]">↗</span></a><a class="card flex items-center justify-between gap-4 p-5" href={GOVT_TOURISM_URL} target="_blank" rel="noopener noreferrer"><span><b class="text-[#072e33]">{GOVT_TOURISM_LABEL}</b><span class="mt-1 block text-sm text-[#60706e]">Official updates and regional tourism information.</span></span><span aria-hidden="true" class="text-2xl text-[#0f6870]">↗</span></a></div></section>
<section id="nearby" class="bg-[#f4e6d1] py-20"><div class="wrap"><p class="eyebrow">Nearby, without commercial endorsements</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33]">Landmarks &amp; Attractions Around {ATTRACTION_SHORT_NAME}</h2><p class="mt-5 max-w-3xl leading-8 text-[#5a6b69]">When visiting <b>{ATTRACTION_FULL_NAME}</b>, visitors can easily explore surrounding historical landmarks and points of interest, including <b>{NEARBY_LANDMARK_1}</b> and <b>{NEARBY_LANDMARK_2}</b>.</p><div class="mt-9 grid gap-5 md:grid-cols-3"><div class="card p-6"><h3 class="font-bold text-[#072e33]">Miramar Beach</h3><p class="mt-2 leading-7 text-[#5a6b69]">A broad urban beach on the Panaji waterfront and a logical scenic stop between the city centre and Dona Paula.</p></div><div class="card p-6"><h3 class="font-bold text-[#072e33]">Goa Science Centre area</h3><p class="mt-2 leading-7 text-[#5a6b69]">A family-friendly educational stop near Miramar that pairs well with a viewpoint visit.</p></div><div class="card p-6"><h3 class="font-bold text-[#072e33]">Lok Bhavan / Cabo area</h3><p class="mt-2 leading-7 text-[#5a6b69]">The Governor’s estate occupies the historic Cabo headland. Public tours are controlled and should only be planned through official channels.</p></div></div><div class="mt-8 card p-7"><h3 class="font-bold text-[#072e33]">Food around the area</h3><p class="mt-2 leading-7 text-[#5a6b69]">For a neutral guide, look by category rather than brand: Goan home-style meals, seafood-focused restaurants, vegetarian Indian kitchens, bakeries, cafés, snack stalls and casual family dining are all typical in the Dona Paula–Miramar–Panaji corridor. Check hygiene, current menus, dietary needs and prices yourself.</p></div></div></section>
<section id="itineraries" class="section"><div class="wrap"><p class="eyebrow">Plan your route</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33]">Recommended itineraries</h2><div class="mt-8 grid gap-6 md:grid-cols-2"><div class="card p-7"><h3 class="text-xl font-bold text-[#072e33]">Half-day (2–3 hours)</h3><p class="mt-3 leading-7 text-[#536969]">Arrive mid-morning or late afternoon. Walk the renovated promenade and viewpoint, photograph the Arabian Sea horizon, then loop toward Miramar Beach for a short sea-facing stretch before heading back to Panaji.</p><ul class="mt-4 space-y-2 text-sm text-[#5b6d6d]"><li>• Viewpoint &amp; jetty (45–60 min)</li><li>• Promenade walk + photos (30 min)</li><li>• Miramar Beach stop (30–45 min)</li></ul></div><div class="card p-7"><h3 class="text-xl font-bold text-[#072e33]">Full-day (5–6 hours)</h3><p class="mt-3 leading-7 text-[#536969]">Add the Cabo / Lok Bhavan headland context, the Goa Science Centre area near Miramar for a family break, and an Old Panaji wander (Fontainhas, markets, riverfront) on the way back. Plan shade and water for the hotter middle of the day.</p><ul class="mt-4 space-y-2 text-sm text-[#5b6d6d]"><li>• Dona Paula viewpoint &amp; promenade (1 hr)</li><li>• Science Centre / Cabo context (1–1.5 hr)</li><li>• Lunch by category in Panaji–Miramar corridor</li><li>• Old Panaji &amp; riverfront (1.5–2 hr)</li></ul></div></div><div class="mt-10"><h3 class="text-2xl font-bold text-[#072e33]">Itineraries by traveller type</h3><div class="mt-5 grid gap-5 md:grid-cols-3">{[['Families with children','Gentle pacing with toilet and shade stops; the paved promenade suits prams. Keep the middle of the day short, carry water and snacks, and treat the sea edge as look-don’t-climb.'],['Photography &amp; nature','Favour the golden hour before sunset or early haze for long horizons; monsoon brings dramatic cloud and rough seas. A polariser helps cut glare on the water.'],['Low-mobility / accessible','Use the paved, renovated promenade and level viewing areas; avoid stepped upper sections. Park near NIO Circle and keep the loop short, with rest stops in shade.']].map(([h,p])=><div class="card p-6"><h4 class="font-bold text-[#072e33]">{h}</h4><p class="mt-2 text-sm leading-6 text-[#5b6d6d]">{p}</p></div>)}</div></div></div></section>
<section id="seasons" class="bg-[#072e33] py-20 text-white"><div class="wrap"><p class="eyebrow !text-[#f0aa64]">When to come</p><h2 class="serif mt-3 text-4xl font-bold">Seasonal visiting strategy</h2><p class="mt-4 max-w-3xl leading-8 text-white/80">The seasons below follow Goa’s typical climate cycle — a synthesis of long-term climate normals for coastal Goa, prevailing sea conditions and the wildlife that each window brings. Use them to pick the month that fits your plans rather than a single “best” date.</p><div class="mt-8 overflow-hidden rounded-2xl border border-white/15"><table class="w-full text-left text-sm"><thead class="bg-white/10"><tr><th class="px-4 py-3 font-semibold">Season</th><th class="px-4 py-3 font-semibold">Weather</th><th class="px-4 py-3 font-semibold">Sea &amp; coast</th><th class="px-4 py-3 font-semibold">Wildlife / nature</th><th class="px-4 py-3 font-semibold">Best for</th></tr></thead><tbody class="divide-y divide-white/10">{[['Dry &amp; cool · Nov–Feb','Pleasant, low rain, comfortable humidity','Calmest, clearest water for views','Migratory birds along estuaries; lively but manageable crowds','Overall visiting, photography, families'],['Hot · Mar–May','High heat and humidity, occasional showers','Warming sea, building pre-monsoon swell','Flowering and nesting activity inland','Early-morning visits; avoid midday'],['Southwest monsoon · Jun–Sep','Heavy, sustained rain; rough seas','Dangerous surf, strong currents — no swimming','Lush green headland; rivers at full flow','Dramatic scenery, fewer crowds (caution needed)'],['Post-monsoon · Oct','Easing rains, greener landscape','Settling conditions, improving clarity','Recovering birdlife; clear air after rains','Quiet light, good value, fewer tourists']].map(([s,w,sea,wl,b])=><tr><td class="px-4 py-3 font-semibold">{s}</td><td class="px-4 py-3 text-white/75">{w}</td><td class="px-4 py-3 text-white/75">{sea}</td><td class="px-4 py-3 text-white/75">{wl}</td><td class="px-4 py-3 text-white/75">{b}</td></tr>)}</tbody></table></div><p class="mt-4 text-xs text-white/60">Sea conditions can change daily; always follow local safety signage and official advisories during the monsoon.</p></div></section>
<section class="section"><div class="wrap grid gap-10 md:grid-cols-2"><div class="photo-commons-1 min-h-[420px] rounded-[32px] bg-[#dce9e6]"></div><div><p class="eyebrow">Coastal science &amp; visitor responsibility</p><h2 class="serif mt-3 text-4xl font-bold text-[#072e33]">The coast is the attraction. Help keep it that way.</h2><p class="mt-5 max-w-3xl leading-8 text-[#536969]">Dona Paula sits where the Mandovi and Zuari river systems meet the Arabian Sea. That mix drives Goa’s coastal ecology: estuaries shelter fish and migratory birds, while the southwest monsoon builds a heavy swell that makes the shoreline dramatic but hazardous. Understanding that cycle is part of visiting responsibly — the same rocks that are safe and dry in January can be slick and wave-hit in July.</p><ul class="mt-6 space-y-4 leading-7 text-[#536969]"><li><b>Stay behind railings:</b> rocky edges can be slippery, especially in monsoon weather.</li><li><b>Take litter out:</b> use bins where available and avoid leaving food packaging near the shoreline.</li><li><b>Respect restricted areas:</b> the nearby Governor’s estate and institutional land have controlled access.</li><li><b>Keep drones and commercial shoots compliant:</b> local security restrictions may apply.</li><li><b>Use neutral, verified information:</b> ticket prices, traffic rules and opening access can change.</li><li><b>Leave wildlife undisturbed:</b> estuaries and headlands are habitats — do not feed birds or stray animals, and keep noise low near nesting areas.</li><li><b>Cut single-use plastic:</b> carry a refillable bottle; the monsoon and tidal zone move loose litter quickly into the sea.</li></ul></div></div></section>
