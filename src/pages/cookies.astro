---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Cookie Settings | Dona Paula View Point Guide" description="Manage cookie preferences for the Dona Paula View Point Guide." path="/cookies/"><section class="section"><div class="wrap max-w-4xl"><p class="eyebrow">Legal</p><h1 class="serif mt-3 text-5xl font-bold text-[#072e33]">Cookie Settings</h1><p class="mt-4 text-[#536969]"><b>Last updated: August 2026</b></p><p class="mt-5 leading-8 text-[#536969]">We use a small amount of browser storage to remember your choices. Analytics is off unless you activate it below.</p><div class="mt-9 space-y-4"><div class="card flex items-center justify-between gap-6 p-6"><div><h2 class="font-bold text-[#072e33]">Necessary storage</h2><p class="mt-1 text-sm leading-6 text-[#5b6d6d]">Required to remember the preferences you choose on this page.</p></div><input class="toggle" type="checkbox" checked disabled aria-label="Necessary storage always active" /></div><div class="card flex items-center justify-between gap-6 p-6"><div><h2 class="font-bold text-[#072e33]">Analytics cookies</h2><p class="mt-1 text-sm leading-6 text-[#5b6d6d]">Google Analytics 4. Helps us understand aggregate visitor behaviour. Off by default.</p></div><input id="analytics" class="toggle" type="checkbox" aria-label="Analytics cookies" /></div><div class="card flex items-center justify-between gap-6 p-6"><div><h2 class="font-bold text-[#072e33]">Preference storage</h2><p class="mt-1 text-sm leading-6 text-[#5b6d6d]">Allows the site to remember non-essential interface preferences. No multilingual selector is used on this site.</p></div><input id="preferences" class="toggle" type="checkbox" aria-label="Preference cookies" /></div><div class="card flex items-center justify-between gap-6 p-6"><div><h2 class="font-bold text-[#072e33]">Marketing cookies</h2><p class="mt-1 text-sm leading-6 text-[#5b6d6d]">This non-profit guide does not activate personalised advertising or marketing cookies.</p></div><input class="toggle" type="checkbox" disabled aria-label="Marketing cookies disabled" /></div></div><div class="mt-7 flex flex-wrap gap-3"><button id="save" class="rounded-full bg-[#072e33] px-6 py-3 font-bold text-white">Save preferences</button><button id="reject" class="rounded-full border border-[#819794] px-6 py-3 font-bold text-[#072e33]">Reject non-essential</button></div><p id="status" class="mt-4 text-sm font-semibold text-[#0f6870]" role="status"></p><div class="mt-10 prose"><h2>Consent management</h2><p>You can return to this page at any time to change your choices. Disabling analytics does not prevent access to core visitor information. Google Maps is an embedded third-party service rather than an analytics cookie controlled by this toggle; loading the map may still involve data processing by Google under its own terms.</p></div></div></section><script is:inline>
(()=>{const k='dp-cookie-preferences',a=document.getElementById('analytics'),p=document.getElementById('preferences'),s=document.getElementById('status');let v={};try{v=JSON.parse(localStorage.getItem(k)||'{}')}catch{}a.checked=v.analytics===true;p.checked=v.preferences===true;const save=(x)=>{localStorage.setItem(k,JSON.stringify(x));s.textContent='Your cookie preferences have been saved.';if(x.analytics===true&&!window.__dpGaLoaded){location.reload();}};document.getElementById('save').addEventListener('click',()=>save({necessary:true,analytics:a.checked,preferences:p.checked,marketing:false}));document.getElementById('reject').addEventListener('click',()=>{a.checked=false;p.checked=false;save({necessary:true,analytics:false,preferences:false,marketing:false})});})();
</script></BaseLayout>
